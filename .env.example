# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (run-migrations.js)
DATABASE_URL=

# Auth
CRON_SECRET=

# Admin script
ADMIN_EMAIL=admin@eyeadvanced.com
ADMIN_PASSWORD=

# Datos de la clinica para los mensajes de WhatsApp/correo al paciente (opcionales)
NEXT_PUBLIC_CLINICA_NOMBRE=EyeAdvanced
NEXT_PUBLIC_CLINICA_DIRECCION=
NEXT_PUBLIC_CLINICA_TELEFONO=

# Monitoreo de errores (Sentry). Sin DSN no se envía nada.
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: % de trazas de rendimiento (0 a 1). Por defecto 0.1
NEXT_PUBLIC_SENTRY_TRACES_RATE=0.1
# Opcional: solo para subir source maps en el build (Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Notificaciones push (Web Push). Generar una sola vez con: npx web-push generate-vapid-keys
# La pública va al navegador; la privada SOLO en el servidor (Vercel → Environment Variables).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com
